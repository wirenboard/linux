# Wiren Board 7 bootlet (initramfs) kernel options
# Applied on top of sunxi_defconfig: make sunxi_defconfig wb7-bootlet.config

#
# Options set by Wiren Board
#

# init
CONFIG_POSIX_MQUEUE=y
CONFIG_TASKSTATS=y
CONFIG_TASK_DELAY_ACCT=y
CONFIG_TASK_XACCT=y
CONFIG_TASK_IO_ACCOUNTING=y
CONFIG_MEMCG=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_EXPERT=y
CONFIG_TRACEPOINTS=y

# kernel/time
CONFIG_NO_HZ=y

# usr
CONFIG_INITRAMFS_SOURCE="initramfs"

# drivers/cpufreq
CONFIG_CPU_FREQ_STAT=y
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y

# kernel/module
CONFIG_MODULE_FORCE_LOAD=y
CONFIG_MODULE_FORCE_UNLOAD=y

# net/ipv4
CONFIG_IP_MULTICAST=y

# net/netlink
CONFIG_NETLINK_DIAG=y

# drivers/of
CONFIG_OF_OVERLAY=y
CONFIG_OF_CONFIGFS=y

# drivers/block
CONFIG_BLK_DEV_LOOP=y

# drivers/misc/eeprom
CONFIG_EEPROM_AT24=y

# drivers/scsi
CONFIG_SCSI=y

# drivers/net/phy
CONFIG_ICPLUS_PHY=y
CONFIG_SMSC_PHY=y

# drivers/input
CONFIG_INPUT_FF_MEMLESS=y

# drivers/input/misc
CONFIG_INPUT_PWM_BEEPER=y
CONFIG_INPUT_WBEC_PWRBUTTON=y

# drivers/i2c
CONFIG_I2C=y

# drivers/i2c/busses
CONFIG_I2C_GPIO=y

# drivers/spi
CONFIG_SPI_SPIDEV=y

# drivers/gpio
CONFIG_GPIO_SYSFS=y
CONFIG_GPIO_WBEC=y

# drivers/power/supply
CONFIG_CHARGER_GPIO=y
CONFIG_WBEC_POWER=y

# drivers/hwmon
CONFIG_SENSORS_IIO_HWMON=y
CONFIG_SENSORS_LM75=y
CONFIG_SENSORS_NTC_THERMISTOR=y

# drivers/watchdog
CONFIG_GPIO_WATCHDOG=y
CONFIG_WBEC_WATCHDOG=y

# drivers/mfd
CONFIG_MFD_SUN4I_GPADC=y
CONFIG_MFD_WBEC=y

# drivers/usb/class
CONFIG_USB_ACM=y

# drivers/usb/storage
CONFIG_USB_STORAGE=y

# drivers/usb/gadget
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y

# drivers/usb/gadget/legacy
CONFIG_USB_ETH=m
CONFIG_USB_GADGETFS=m
CONFIG_USB_FUNCTIONFS=m
CONFIG_USB_MASS_STORAGE=m

# drivers/usb/roles
CONFIG_USB_ROLE_SWITCH=y

# drivers/leds
CONFIG_LEDS_PWM=y

# drivers/leds/trigger
CONFIG_LEDS_TRIGGER_TIMER=y
CONFIG_LEDS_TRIGGER_CPU=y
CONFIG_LEDS_TRIGGER_ACTIVITY=y
CONFIG_LEDS_TRIGGER_DEFAULT_OFF=y
CONFIG_LEDS_TRIGGER_TRANSIENT=y
CONFIG_LEDS_TRIGGER_PATTERN=y

# drivers/rtc
CONFIG_RTC_DRV_PCF85063=y
CONFIG_RTC_INTF_SYSFS=y

# drivers/dma-buf
CONFIG_SYNC_FILE=y

# drivers/devfreq
CONFIG_PM_DEVFREQ=y
CONFIG_DEVFREQ_GOV_SIMPLE_ONDEMAND=y

# drivers/iio
CONFIG_IIO_BUFFER=y
CONFIG_IIO_TRIGGER=y

# drivers/iio/adc
CONFIG_SUN4I_GPADC=y

# drivers/iio/afe
CONFIG_IIO_RESCALE=y

# drivers/iio/dac
CONFIG_AD5064=y
CONFIG_MCP4728=y

# drivers/iio/trigger
CONFIG_IIO_SYSFS_TRIGGER=y

# drivers/pwm
CONFIG_PWM_SUN8I=y

# drivers/ras
CONFIG_RAS=y

# fs/ext4
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y

# fs/autofs
CONFIG_AUTOFS_FS=y

# fs/fat
CONFIG_MSDOS_FS=y

# fs/exfat
CONFIG_EXFAT_FS=y

# fs/ntfs3
CONFIG_NTFS_FS=y

# fs
CONFIG_TMPFS_POSIX_ACL=y

# fs/nls
CONFIG_NLS_CODEPAGE_866=y
CONFIG_NLS_CODEPAGE_1251=y
CONFIG_NLS_UTF8=y

# security
CONFIG_SECURITYFS=y

# crypto
CONFIG_CRYPTO=y
CONFIG_CRYPTO_AUTHENC=y
CONFIG_CRYPTO_CCM=y
CONFIG_CRYPTO_DEFLATE=y
CONFIG_CRYPTO_LZO=y

# drivers/crypto/allwinner
CONFIG_CRYPTO_DEV_SUN4I_SS=y
CONFIG_CRYPTO_DEV_SUN8I_CE=y
CONFIG_CRYPTO_DEV_SUN8I_SS=y

# lib
CONFIG_PANIC_ON_OOPS=y
CONFIG_STRICT_DEVMEM=y
CONFIG_BINARY_PRINTF=y

# arch/powerpc
CONFIG_PANIC_TIMEOUT=10

# arch/x86
CONFIG_UNWINDER_FRAME_POINTER=y

# arch/arm
CONFIG_DEBUG_USER=y

# net/ipv6
CONFIG_IPV6=y

# net
CONFIG_WIRELESS=y

# kernel/trace
CONFIG_RING_BUFFER=y
CONFIG_FTRACE=y
CONFIG_EPROBE_EVENTS=y
CONFIG_EVENT_TRACING=y
CONFIG_CONTEXT_SWITCH_TRACER=y
CONFIG_UPROBE_EVENTS=y
CONFIG_PROBE_EVENTS=y
CONFIG_TRACEFS_AUTOMOUNT_DEPRECATED=y
CONFIG_TRACING=y
CONFIG_NOP_TRACER=y
CONFIG_BRANCH_PROFILE_NONE=y
CONFIG_DYNAMIC_EVENTS=y

# kernel/rcu
CONFIG_TASKS_RCU_GENERIC=y
CONFIG_TASKS_TRACE_RCU=y
CONFIG_NEED_TASKS_RCU=y

# arch
CONFIG_UPROBES=y

